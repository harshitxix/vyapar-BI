# Database Configuration
# Use PostgreSQL connection string: postgresql+asyncpg://user:password@localhost:5432/vyapar_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vyapar_db
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/vyapar_db

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Scheduler Configuration
SCHEDULER_ENABLED=true
DEFAULT_POLL_INTERVAL=900

# AI Enrichment Configuration (Phase 2)
AI_ENRICHMENT_ENABLED=true
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
OPENAI_MODEL=gpt-4o-mini
AI_BATCH_SIZE=5
AI_MAX_RETRIES=3
AI_PROMPT_VERSION=v1.0

